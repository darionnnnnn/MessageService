{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Deployment": {
    "Mode": "AllInOne"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=Db/messages.db",
    "SqlServer": "",
    "Outbox": "Data Source=Db/outbox.db"
  },
  "Viewer": {
    "AllowedClientIps": []
  },
  "UseForwardedHeaders": false,
  "Http": {
    "UseHttpsRedirection": false
  },
  "Line": {
    "ChannelSecret": "",
    "ChannelAccessToken": ""
  },
  "Ingest": {
    "BaseUrl": "",
    "ApiKey": "",
    "MaxContentBytes": 314572800,
    "AllowedClientIps": []
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "BaseRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300
  },
  "Heartbeat": {
    "IntervalSeconds": 60,
    "OutboxBacklogAlertMinutes": 30
  },
  "Retention": {
    "CleanupTimeOfDay": "03:00:00"
  },
  "ContentDownload": {
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 2000,
    "TranscodingPollSeconds": 5,
    "TranscodingMaxPolls": 24,
    "MaxConcurrency": 3,
    "FailedRetryWindowDays": 7,
    "MaxFailedRetries": 10,
    "RequeueIntervalMinutes": 15
  },
  "ProfileCache": {
    "RefreshAfter": "7.00:00:00",
    "FailureRetryAfter": "00:10:00"
  },
  "Encryption": {
    "Enabled": false,
    "Key": "",
    "SearchWindowDays": 14
  }
}
