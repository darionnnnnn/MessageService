@{
    ViewData["Title"] = "對話";
    ViewData["BodyClass"] = "chat-page";
}

<div id="chat-app" class="chat-app">
    <aside id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <span class="app-brand-dot" aria-hidden="true"></span>
            訊息紀錄
        </div>
        <div class="sidebar-search">
            <span class="sidebar-search-icon" aria-hidden="true">🔍</span>
            <input id="group-search" type="search" class="form-control form-control-sm" placeholder="搜尋群組" aria-label="搜尋群組">
        </div>
        <div id="group-list" class="group-list">
            <div class="group-list-empty">載入群組中…</div>
        </div>
        <div class="sidebar-footer">
            <a href="/Home/Settings" class="sidebar-settings-link">
                <span aria-hidden="true">⚙️</span>
                設定
            </a>
        </div>
    </aside>

    <section id="chat-panel" class="chat-panel">
        <header id="chat-header" class="chat-header">
            <button id="mobile-back-btn" type="button" class="mobile-back-btn" aria-label="返回群組列表">‹</button>
            <div id="chat-header-avatar" class="avatar chat-header-avatar"></div>
            <div class="chat-header-info">
                <span id="chat-header-name" class="chat-header-name">選擇一個群組</span>
                <span id="chat-header-members" class="chat-header-members"></span>
            </div>
            <div class="font-size-toggle dropdown">
                <button class="btn btn-sm btn-header-action dropdown-toggle" type="button" id="font-size-dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">Aa</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button type="button" class="dropdown-item" data-font-size="small">小</button></li>
                    <li><button type="button" class="dropdown-item" data-font-size="medium">中</button></li>
                    <li><button type="button" class="dropdown-item" data-font-size="large">大</button></li>
                </ul>
            </div>
        </header>

        <div id="connection-banner" class="connection-banner d-none">連線中斷，正在嘗試重新連線…</div>

        <div id="message-area" class="message-area">
            <button id="load-more-btn" type="button" class="load-more-pill" disabled>載入更早 7 天</button>
            <div id="message-list" class="message-list"></div>
        </div>

        <button id="scroll-bottom-btn" type="button" class="scroll-bottom-btn d-none" aria-label="回到最新訊息">
            <span id="unread-badge" class="badge text-bg-danger d-none">0</span>
            <span aria-hidden="true">↓</span>
        </button>

        <footer class="composer-bar" aria-hidden="true">
            <span class="composer-icon">＋</span>
            <span class="composer-icon">📷</span>
            <span class="composer-icon">🖼</span>
            <div class="composer-pill">
                <span id="composer-status-dot" class="composer-status-dot"></span>
                <span id="composer-status-text">唯讀檢視模式・同步中</span>
            </div>
            <span class="composer-icon">☺</span>
            <span class="composer-icon">🎤</span>
        </footer>
    </section>
</div>

<div class="modal fade" id="image-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark">
            <div class="modal-body p-0 text-center">
                <img id="image-modal-img" src="" class="img-fluid" alt="圖片預覽">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
