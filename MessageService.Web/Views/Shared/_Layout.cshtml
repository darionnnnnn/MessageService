@{
    var isChatPage = (string?)ViewData["BodyClass"] == "chat-page";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 訊息紀錄</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MessageService.Web.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @if (isChatPage)
    {
        @RenderBody()
    }
    else
    {
        <header class="simple-header">
            <a class="simple-header-back" asp-area="" asp-controller="Home" asp-action="Index">‹ 返回聊天</a>
            <span class="simple-header-title">@ViewData["Title"]</span>
        </header>
        <main class="simple-main">
            @RenderBody()
        </main>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
