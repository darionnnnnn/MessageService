<?xml version="1.0" encoding="utf-8"?>
<!--
  只承載非機密的宿主設定；machine/process 相關值由 dotnet publish 依專案設定自動填入
  processPath/arguments，這裡手動維護的只有 requestLimits 與環境變數本身要不要存在。
  機密（Line__ChannelSecret 等）與各主機的實際部署設定改放站台目錄下的
  appsettings.Production.json（不進版控，見 deploy/ 底下的樣板與 .gitignore），
  這裡刻意不再放任何環境變數形式的機密——見 docs/history/CONSOLIDATION-PLAN.md 階段5。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MessageService.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 對齊 appsettings 的 Ingest:MaxContentBytes（預設 314572800＝300MB）——
               改一邊要記得改另一邊，否則兩層限制取較小值，大檔案上傳會在這裡先被 IIS 擋下來，
               而不是走到 IngestController 給出更明確的錯誤訊息 -->
          <requestLimits maxAllowedContentLength="314572800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
