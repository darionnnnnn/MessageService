<?xml version="1.0" encoding="utf-8"?>
<!--
  只承載非機密的宿主設定；machine/process 相關值由 dotnet publish 依專案設定自動填入
  processPath/arguments，這裡手動維護的只有 requestLimits 與環境變數本身要不要存在。
  機密（Line__ChannelSecret 等）與各主機的實際部署設定改放站台目錄下的
  appsettings.Production.json（不進版控，見 deploy/ 底下的樣板與 .gitignore），
  這裡刻意不再放任何環境變數形式的機密——見 docs/history/CONSOLIDATION-PLAN.md 階段5。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit：ANCM 預設只給 120 秒，但本站台在 app.Run() 之前會同步跑
           Database.Migrate()。資料量大的環境（尤其 blob 拆表那種整表搬遷）很容易超過 120 秒，
           一旦逾時 IIS 會判定啟動失敗並回收行程，下一個請求又從頭再跑一次 migration，形成
           站台永久 500.3x 的無限迴圈。拉到 3600 秒讓長時間 migration
           有機會跑完。升級大型資料庫時另外建議依 docs/DEPLOYMENT-GUIDE.md 先離線跑完
           migration，並暫時把 stdoutLogEnabled 改成 true 以便留下啟動階段的紀錄。
           migration 本身的開始／完成／耗時會記在 logs/messageservice-{日期}.log。 -->
      <aspNetCore processPath="dotnet" arguments=".\MessageService.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" startupTimeLimit="3600">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 對齊 appsettings 的 Ingest:MaxContentBytes（預設 314572800＝300MB）——
               改一邊要記得改另一邊，否則兩層限制取較小值，大檔案上傳會在這裡先被 IIS 擋下來，
               而不是走到 IngestController 給出更明確的錯誤訊息。
               IIS 預設的 maxQueryString 為 2048 bytes，超過時會直接回 404.15 且應用程式 log
               看不到任何線索；前端的 ?ids= 都已經自己控制長度，這裡是第二層保險。 -->
          <requestLimits maxAllowedContentLength="314572800" maxQueryString="8192" maxUrl="8192" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
