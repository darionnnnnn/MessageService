<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- 服務本身的關鍵 log：收訊、下載、清除、錯誤 -->
    <target xsi:type="File" name="appFile"
            fileName="logs/messageservice-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=|${exception:format=tostring}}"
            archiveEvery="Day"
            maxArchiveDays="30"
            encoding="utf-8" />

    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=|${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Microsoft/System 的雜訊只留 Warning 以上 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="appFile,console" />
  </rules>
</nlog>
