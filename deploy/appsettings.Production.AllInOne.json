{
  // 單機部署：收 webhook＋直連資料庫＋檢視端，一台包辦。最常見的拓撲，
  // 適合小到中型規模；資料量／流量大到需要拆機時才需要換成 Edge+Core(+Viewer)，
  // 見 docs/DEPLOYMENT-MODES.md。
  "Deployment": {
    "Mode": "AllInOne"
  },
  "Database": {
    // 預設 Sqlite，單機部署夠用且免額外安裝資料庫伺服器。訊息量／並發使用者數
    // 成長到讓 Sqlite 的單一寫入鎖成為瓶頸時，改成 "SqlServer" 並在下面補上
    // ConnectionStrings:SqlServer——不需要動任何程式碼。
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    // messages.db／outbox.db 是本機檔案，路徑指到站台目錄以外的地方，避免
    // IIS 站台重新部署（覆蓋整個目錄）時一併把資料庫檔案洗掉
    "Sqlite": "Data Source=C:\\Deploy\\MessageService\\messages.db",
    "Outbox": "Data Source=C:\\Deploy\\MessageService\\outbox.db"
    // 若把 Database:Provider 改成 SqlServer，這裡另外加一組：
    // "SqlServer": "Server=...;Database=MessageService;..."
  },
  "Viewer": {
    // 空陣列＝全部拒絕，安全預設值。填入實際會用檢視端的來源網段（例如辦公室 LAN），
    // 支援單一 IP（"127.0.0.1"）與 CIDR 網段（"10.1.0.0/24"）
    "AllowedClientIps": []
  },
  "Line": {
    // 從 LINE Developers Console 的 Channel 取得，兩把金鑰不同分頁，見
    // docs/LINE-BOT-SETUP.md。這是機密，只填在部署到主機的這份檔案裡，不進版控
    "ChannelSecret": "",
    "ChannelAccessToken": ""
  },
  "Encryption": {
    // 選用。要開的話見 docs/ENCRYPTION.md——單機部署沒有多台金鑰要對齊的問題，
    // 但金鑰本身仍然遺失即無法復原，開之前先讀過那份文件的部署檢查清單
    "Enabled": false,
    "Key": ""
  }
}
