{
  // 單機部署：收 webhook＋直連資料庫＋檢視端，一台包辦。最常見的拓撲，
  // 適合小到中型規模；資料量／流量大到需要拆機時才需要換成 Edge+Core(+Viewer)，
  // 見 docs/DEPLOYMENT-MODES.md。
  "Deployment": {
    "Mode": "AllInOne"
  },
  "Database": {
    // 不填這個鍵：沒設 ConnectionStrings:SqlServer 就用 Sqlite（單機部署夠用、免額外安裝
    // 資料庫伺服器），填了就自動改用 SqlServer——不需要另外設定這個鍵，也不需要動任何程式碼。
    // 只有想覆寫推導結果時才需要顯式填 "Sqlite" 或 "SqlServer"。
    //
    // 填了 ConnectionStrings:SqlServer 時，啟動當下會先探測連得上、schema 也對；探測失敗
    // （SQL Server 還沒裝好、連線字串打錯、防火牆擋住等）就自動改用本機 SQLite 撐起服務，
    // 檢視端「主機狀態」分頁會顯示救援模式的警告。修好 SQL Server 後重啟即可切回——這段期間
    // 寫入本機 SQLite 的資料不會自動搬過去，見 docs/DEPLOYMENT-GUIDE.md。不想要這個行為
    // （寧可啟動失敗也不要悄悄換資料庫）可以加 "SqliteFallback": false。
    "SqliteFallback": true
  },
  "ConnectionStrings": {
    // 預設放在站台目錄下的 Db\ 資料夾（相對路徑，以站台的 ContentRootPath 為基準，第一次
    // 啟動時會自動建立目錄）。一般的 dotnet publish 覆蓋式重佈不會動它，安全；但如果你的
    // 重佈方式是「先清空目錄再放新版」（robocopy /MIR、Web Deploy 同步刪除、砍資料夾重解壓），
    // 請先把 Db\ 資料夾搬到站台目錄以外（例如 C:\ProgramData\MessageService\），
    // 再把這裡改成絕對路徑，例如 "Data Source=C:\\ProgramData\\MessageService\\messages.db"
    "Sqlite": "Data Source=Db/messages.db",
    "Outbox": "Data Source=Db/outbox.db"
    // 訊息量／並發使用者數成長到讓 Sqlite 的單一寫入鎖成為瓶頸時，這裡加一組
    // "SqlServer": "Server=...;Database=MessageService;..." 就會自動改用 SQL Server
  },
  "Viewer": {
    // 空陣列＝全部拒絕，安全預設值。填入實際會用檢視端的來源網段（例如辦公室 LAN），
    // 支援單一 IP（"127.0.0.1"）與 CIDR 網段（"10.1.0.0/24"）
    "AllowedClientIps": []
  },
  "Line": {
    // 從 LINE Developers Console 的 Channel 取得，兩把金鑰不同分頁，見
    // docs/LINE-BOT-SETUP.md。這是機密，只填在部署到主機的這份檔案裡，不進版控
    "ChannelSecret": "",
    "ChannelAccessToken": ""
  },
  "Encryption": {
    // 選用。要開的話見 docs/ENCRYPTION.md——單機部署沒有多台金鑰要對齊的問題，
    // 但金鑰本身仍然遺失即無法復原，開之前先讀過那份文件的部署檢查清單
    "Enabled": false,
    "Key": ""
  }
}
