{
  // 只收 LINE webhook，不直連資料庫；透過 ingest API 把資料交給 Core 主機。
  // 這是直接對 LINE 曝露的最外緣主機——沒有 Database 區塊是刻意的，這個角色
  // 完全不碰 MessageDbContext，也不該碰加密金鑰（見下方 Encryption 說明）
  "Deployment": {
    "Mode": "Edge"
  },
  "ConnectionStrings": {
    // outbox.db 是本機緩衝佇列（還沒送到 Core 的事件都在這裡）。預設放在站台目錄下的
    // Db\ 資料夾，第一次啟動時自動建立。若重佈方式是「先清空目錄再放新版」，請先搬到
    // 站台目錄以外再改成絕對路徑，見 appsettings.Production.AllInOne.json 的說明
    "Outbox": "Data Source=Db/outbox.db"
  },
  "Line": {
    // 從 LINE Developers Console 的 Channel 取得，兩把金鑰不同分頁，見
    // docs/LINE-BOT-SETUP.md。這是機密，只填在部署到主機的這份檔案裡，不進版控
    "ChannelSecret": "",
    "ChannelAccessToken": ""
  },
  "Ingest": {
    // 指向 Core 主機的位址；升級順序建議先升 Core 再升 Edge（見
    // docs/DEPLOYMENT-MODES.md），批次端點在 Core 還沒升級時會自動退回逐筆模式
    "BaseUrl": "https://core-host.example/",
    // 必須跟 Core 主機那份 appsettings.Production.Core.json 裡的 Ingest:ApiKey
    // 逐字相同，雙邊各自產生一份不會一致
    "ApiKey": "",
    // 允許呼叫 /api/edge（Core 主動輪詢用）的來源 IP：填 Core 主機的位址。
    // 空清單等於全部拒絕——防火牆只開通 core→edge 時沒填這個，輪詢會一律吃 403。
    // 只走推送（edge→core 有開通）的部署可以留空，那組端點本來就不會被呼叫
    "AllowedClientIps": [],
    // Auto（預設）：推送優先，不通就由 Core 輪詢接手；心跳每分鐘照打，一通就自動恢復推送。
    // 確定 edge→core 永遠不會開通時設 "Pull"（不做任何主動連線，BaseUrl 可留空）；
    // 確定只走推送時設 "Push"（不開放 /api/edge）。見 docs/DEPLOYMENT-MODES.md
    "Channel": "Auto"
  }
  // 不要加 Encryption 區塊：Edge 沒有資料庫可寫，金鑰對它毫無用途，見
  // docs/ENCRYPTION.md「拆機部署的例外」——放了金鑰只是白白多一個外洩面
}
