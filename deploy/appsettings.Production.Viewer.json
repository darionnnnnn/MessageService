{
  // 純檢視端：直連資料庫、只提供瀏覽介面，不收 webhook、不開 ingest API。
  // 三台拓撲（Edge+Core+Viewer）下與 Edge／Core 各佔一台主機時使用；
  // 如果只是兩台拓撲，不需要這份樣板，Core 主機自己就會一併提供檢視端
  "Deployment": {
    "Mode": "Viewer"
  },
  "Database": {
    // 預設 SqlServer，不是 Sqlite——這台是獨立主機，透過網路連到 Core 主機
    // 寫入的同一顆資料庫。SQLite 是本機檔案型資料庫，跨主機透過網路磁碟共用
    // 同一個 .db 檔案不可行（SMB 上的檔案鎖不可靠，SQLite 官方也明確不建議）。
    // 例外：如果 Viewer 角色其實是跟 Core 部署在「同一台機器」的第二個站台
    // （不是獨立主機），才可以改回 "Sqlite" 並指向跟 Core 完全相同的檔案路徑，
    // 此時 AutoMigrate 也要一併拿掉（下方的 false 只在真的獨立主機時成立）
    "Provider": "SqlServer",
    // schema 由 Core 負責 Migrate()；Viewer 通常只有讀取權限（見下方帳號權限說明），
    // AutoMigrate 預設 true 的話，這台在啟動時會嘗試 DDL 而直接失敗
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    // 跟 Core 主機那份 appsettings.Production.Core.json 指向同一顆資料庫；
    // 帳號通常只需要 db_datareader（加上少量寫入權限給 ViewerSettings／
    // MaskKeywords／UserAliases／AnonymousIdentities 這幾張檢視端會寫的表）
    "SqlServer": "Server=...;Database=MessageService;..."
  },
  "Viewer": {
    // 空陣列＝全部拒絕。填入實際會用檢視端的來源網段（辦公室 LAN）
    "AllowedClientIps": []
  },
  "Encryption": {
    // 開啟的話，這台跟 Core 主機的 Encryption:Key 必須逐字相同，見
    // docs/ENCRYPTION.md；Edge 主機不直連資料庫，不需要設這個值
    "Enabled": false,
    "Key": ""
  }
}
