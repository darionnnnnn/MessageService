{
  // 純檢視端：直連資料庫、只提供瀏覽介面，不收 webhook、不開 ingest API。
  // 三台拓撲（Edge+Core+Viewer）下與 Edge／Core 各佔一台主機時使用；
  // 如果只是兩台拓撲，不需要這份樣板，Core 主機自己就會一併提供檢視端
  "Deployment": {
    "Mode": "Viewer"
  },
  "Database": {
    // 這裡刻意顯式填 "SqlServer"，跟其他三份樣板（改用「沒填就依連線字串推導」）不同——
    // Viewer 沒有 AllInOne 才有的 SQLite 救場機制，如果不小心漏填下面的 ConnectionStrings:
    // SqlServer，顯式設定能讓啟動當下直接報錯擋下來；若拿掉這個鍵改成推導，同樣的疏漏會
    // 讓程式悄悄改用一顆空的本機 SQLite 安靜啟動，檢視端看起來像「還沒有任何訊息」，
    // 比啟動失敗更難察覺。
    //
    // 這台是獨立主機，透過網路連到 Core 主機寫入的同一顆資料庫。SQLite 是本機檔案型
    // 資料庫，跨主機透過網路磁碟共用同一個 .db 檔案不可行（SMB 上的檔案鎖不可靠，SQLite
    // 官方也明確不建議）。例外：如果 Viewer 角色其實是跟 Core 部署在「同一台機器」的第二個
    // 站台（不是獨立主機），才可以改回 "Sqlite" 並指向跟 Core 完全相同的檔案路徑，
    // 此時 AutoMigrate 也要一併拿掉（下方的 false 只在真的獨立主機時成立）
    "Provider": "SqlServer",
    // schema 由 Core 負責 Migrate()；Viewer 通常只有讀取權限（見下方帳號權限說明），
    // AutoMigrate 預設 true 的話，這台在啟動時會嘗試 DDL 而直接失敗
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    // 跟 Core 主機那份 appsettings.Production.Core.json 指向同一顆資料庫；
    // 帳號通常只需要 db_datareader（加上少量寫入權限給下列檢視端會寫的表）：
    //   ViewerSettings／MaskKeywords／MaskKeywordGroups／UserAliases／AnonymousIdentities
    //   HostHeartbeats（HeartbeatService 每 60 秒 upsert 一次，所有模式都跑，漏給這個
    //     權限的話這台會每分鐘噴一次心跳寫入錯誤，而且會在「主機狀態」頁上自己顯示成離線）
    //   Groups（保留期清除刪掉某群組最後一則訊息後，GroupsController 的自癒路徑
    //     會即時查回並更新該群組列，這個寫入不常見但確實存在）
    "SqlServer": "Server=...;Database=MessageService;..."
  },
  "Viewer": {
    // 空陣列＝全部拒絕。填入實際會用檢視端的來源網段（辦公室 LAN）
    "AllowedClientIps": []
  },
  "Encryption": {
    // 開啟的話，這台跟 Core 主機的 Encryption:Key 必須逐字相同，見
    // docs/ENCRYPTION.md；Edge 主機不直連資料庫，不需要設這個值
    "Enabled": false,
    "Key": ""
  }
}
