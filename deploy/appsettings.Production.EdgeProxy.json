{
  // 只把 LINE webhook 原封轉發給內網的 Edge 主機。部署在公司既有的、有合法憑證的對外
  // 伺服器上（IIS 既有站台底下加一個 application），解決 Edge 沒有合法 HTTPS 憑證、
  // 無法直接當 LINE webhook 目標的問題。見 docs/DEPLOYMENT-GUIDE.md 的 Part E1c。
  //
  // 這個角色刻意什麼都不做：不碰資料庫、不緩衝、不落地、不重試、不驗簽、不持有任何金鑰。
  // 所以這份設定檔沒有 Line／Ingest／Database／Encryption 區塊——那些填了不會有任何作用，
  // 其中 Line／Ingest／Viewer／SQL Server 連線字串填了會在啟動時記一行 Warning 提醒
  // （見 DeploymentValidator）。
  "Deployment": {
    "Mode": "EdgeProxy"
  },
  "EdgeProxy": {
    // Edge 主機的位址。Edge 裝在 IIS 子應用程式底下時要把那段路徑寫進來
    // （例如 http://192.0.2.10/MSLine），結尾斜線寫不寫都可以，程式會補齊
    "TargetBaseUrl": "http://192.0.2.10/MSLine",
    // 轉發到 Edge 的逾時秒數。逾時會回 502，由 LINE 的 redelivery 重送
    "TimeoutSeconds": 10,
    // 只有在 Edge 端設了 Line:OutboundVia=EdgeProxy（LINE outbound 也走這台）時才需要：
    // 填 Edge 主機的 IP。空清單＝全擋，Edge 的每個 outbound 都會吃 403。
    // 注意這份白名單只保護 /line/*，webhook 轉發那條不吃它（LINE 來源 IP 不固定）
    "AllowedClientIps": []
  }
}
